<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Departure Logs | Dispatch List</title>
    <link rel="icon" type="image/png" href="/stickers/logo-sys.png" />
    <link rel="stylesheet" href="/css/departure.css" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    
</head>
<body>
    <div class="dashboard-container">
        <aside class="sidebar">
            <div class="logo-container">
                <img src="/stickers/tracking.png" alt="Logo" class="logo" onerror="this.src='https://placehold.co/190x80?text=Dispatch+Hub'">
            </div>
            <nav class="nav-menu">
                <a href="/Dashboard" class="nav-btn"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                <a href="/DriverList" class="nav-btn"><i class="fas fa-users"></i> Driver list</a>
                <a href="/DepartureLogs" class="nav-btn active"><i class="fas fa-sign-out-alt"></i> Departure logs</a>
                <a href="/vehicles" class="nav-btn"><i class="fas fa-truck"></i> Vehicles</a>
                <a href="/SCroute" class="nav-btn"><i class="fas fa-route"></i> Routes</a>
                <a href="/sample3D" class="nav-btn "><i class="fas fa-map-marked-alt"></i> Dispatch Area</a>
            </nav>
            <div class="upload-section">
                <a href="/farePrice" class="upload-btn active"><i class="fas fa-ticket-alt"></i> Fare Prices</a>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
    <main class="main-content">

      <!-- HEADER -->
      <header class="dashboard-header">
        <div class="header-left">
          <h1>Welcome, {{adminAuth.first_name}}</h1>
          <p>Fare Prices</p>
        </div>

        <div class="header-right">
          <div class="admin-info">
            <strong>{{adminAuth.role}}</strong>
          </div>
        </div>
      </header>

            <!-- DEPARTURE LOG LISTING UI (empty state, ready for dynamic data) -->
            <div class="logs-panel">
                <div class="logs-header">
                    <div class="section-title">
                        <i class="fas fa-calendar-check"></i>
                        <span>Departure Logs</span>
                    </div>
                    <div class="filter-bar">
                        <i class="fas fa-search"></i>
                        <input type="text" id="searchInput" placeholder="Filter by driver, route or bus..." autocomplete="off">
                    </div>
                </div>
                <div class="table-container">
                    <table class="departure-table" id="departureTable">
                       <table class="departure-table" id="departureTable">
                            <thead>
                                <tr>
                                    <th>Plate Number</th>
                                    <th>Driver Name</th>
                                    <th>Arrival Time</th>
                                    <th>Departure Time</th>
                                    <th>Log ID</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                <tr class="empty-row">
                                    <td colspan="5">
                                        <i class="fas fa-cloud-upload-alt" style="font-size: 1.8rem; opacity: 0.6; display: block; margin-bottom: 8px;"></i>
                                        No departure logs loaded. Data will appear here.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                </div>
                <div class="log-stats">
                    <div><i class="fas fa-chart-line"></i> <span id="logCount">0</span> total departures</div>
                    <div class="refresh-hint"><i class="fas fa-sync-alt"></i> Ready for integration</div>
                </div>
            </div>
        </main>
    </div>

    
</body>
</html>