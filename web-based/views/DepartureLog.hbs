<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Departure Logs | Dispatch List</title>
    <link rel="icon" type="image/png" href="/stickers/logo-sys.png" />
    <link rel="stylesheet" href="/css/departure.css" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/docx@7.8.2/build/index.js"></script>
    <script defer src="/js/departureReport.js"></script>
    <script defer src="/js/departLogs.js"></script>
</head>
<body>
    <div class="dashboard-container">
        <aside class="sidebar">
            <div class="logo-container">
                <img src="/stickers/tracking.png" alt="Logo" class="logo" onerror="this.src='https://placehold.co/190x80?text=Dispatch+Hub'">
            </div>
            <nav class="nav-menu">
                <a href="/Dashboard" class="nav-btn"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                <a href="/DriverList" class="nav-btn"><i class="fas fa-users"></i> Driver list</a>
                <a href="/DepartureLogs" class="nav-btn active"><i class="fas fa-sign-out-alt"></i> Departure logs</a>
                <a href="/vehicles" class="nav-btn"><i class="fas fa-truck"></i> Vehicles</a>
                <a href="/SCroute" class="nav-btn"><i class="fas fa-route"></i> Routes</a>
                <a href="/sample3D" class="nav-btn "><i class="fas fa-map-marked-alt"></i> Dispatch Area</a>
            </nav>
            <div class="upload-section">
                <a href="/farePrice" class="upload-btn active"><i class="fas fa-ticket-alt"></i> Fare Prices</a>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">

            <!-- HEADER -->
            <header class="dashboard-header">
                <div class="header-left">
                    <h1>Welcome, {{adminAuth.first_name}}</h1>
                    <p>Departure Logs Overview</p>
                </div>

                <div class="header-right">
                    <div class="admin-info">
                        <strong>{{adminAuth.role}}</strong>
                    </div>
                </div>
            </header>

            <!-- DEPARTURE LOG LISTING -->
            <div class="logs-panel">

                <div class="logs-header">
                    <div class="section-title">
                        <div class="section-title-heading">
                            <i class="fas fa-calendar-check"></i>
                            <span>Departure Logs</span>
                        </div>
                        <p>All departures, grouped by terminal</p>
                    </div>

                    <div class="route-selector">
                        <select id="terminal_id" name="terminal_id">
                            <option value="">Select Terminal</option>
                        </select>
                         <input type="date" id="departure_date" />
                        <button type="button" id="openReportBtn" class="report-btn">
                            <i class="fas fa-file-export"></i> Generate Report
                        </button>
                    </div>
                </div>

               
                <div class="table-container">
                    <table class="departure-table" id="departureTable">
                        <thead>
                            <tr>
                                <th>Log ID</th>
                                <th>Plate</th>
                                <th>Driver Name</th>
                                <th>Route</th>
                                <th>approve by</th>
                                <th>Departed</th>
                            </tr>
                        </thead>
                        <tbody id="departure-list">
                            <tr class="loading-row">
                                <td colspan="6">
                                    <i class="fas fa-spinner fa-spin" style="font-size: 1.6rem; opacity: 0.6; display: block; margin-bottom: 8px;"></i>
                                    Loading departure logs…
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div id="departure-empty" class="empty-state" style="display: none;">
                        <i class="fas fa-inbox"></i>
                        <p>No departure logs loaded. Data will appear here.</p>
                    </div>
                </div>

                <div class="log-stats">
                    <div>
                        <i class="fas fa-chart-line"></i>
                        <span id="departure-total">0 total departures</span>
                    </div>
                    <div class="refresh-hint">
                        <i class="fas fa-sync-alt"></i>
                        Updates on page load
                    </div>
                </div>
            </div>

        </main>
    </div>

            <div class="modal-overlay" id="reportModal" style="display:none;">
        <div class="modal-box">
            <div class="modal-head">
            <h3><i class="fas fa-file-alt"></i> Generate Departure Report</h3>
            <button type="button" id="closeReportBtn" class="modal-close">&times;</button>
            </div>

            <div class="modal-body">
            <p class="modal-terminal">Terminal: <strong id="reportTerminalName">—</strong></p>

            <div class="form-row">
                <label>From
                <input type="date" id="reportFrom" />
                </label>
                <label>To
                <input type="date" id="reportTo" />
                </label>
            </div>

            <div class="form-group">
                <span class="form-label">Format</span>
                <label class="radio"><input type="radio" name="reportFormat" value="pdf" checked> PDF</label>
                <label class="radio"><input type="radio" name="reportFormat" value="docx"> Word (.docx)</label>
            </div>

            <div class="form-group">
                <label class="radio">
                <input type="checkbox" id="includeHeader" checked> Include document header
                </label>
                <div id="headerFields">
                <input type="text" id="hdrOrg"      placeholder="Organization / Company name" />
                <input type="text" id="hdrTitle"    placeholder="Report title (e.g. Departure Logs Report)" />
                <input type="text" id="hdrSubtitle" placeholder="Address / subtitle (optional)" />
                <small>Saved automatically, so you only set this once.</small>
                </div>
            </div>

            <p id="reportStatus" class="report-status"></p>
            </div>

            <div class="modal-foot">
            <button type="button" id="cancelReportBtn" class="btn-secondary">Cancel</button>
            <button type="button" id="generateReportBtn" class="btn-primary">
                <i class="fas fa-download"></i> Download
            </button>
            </div>
        </div>
        </div>

</body>
</html>