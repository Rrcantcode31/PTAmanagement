<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vehicles</title>
    <link rel="icon" type="image/png" href="/stickers/logo-sys.png" />
    <link rel="stylesheet" href="/css/vehicles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <script src="/js/vehicles.js"></script>
</head>
<body>
    <div class="dashboard-container">
        <aside class="sidebar">
            <div class="logo-container">
                <img src="/stickers/tracking.png" alt="Logo" class="logo" onerror="this.src='https://placehold.co/190x80?text=Dispatch+Hub'">
            </div>
            <nav class="nav-menu">
                <a href="/Dashboard" class="nav-btn"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                <a href="/DriverList" class="nav-btn"><i class="fas fa-users"></i> Driver list</a>
                <a href="/DepartureLogs" class="nav-btn "><i class="fas fa-sign-out-alt"></i> Departure logs</a>
                <a href="/vehicles" class="nav-btn active"><i class="fas fa-truck"></i> Vehicles</a>
                <a href="/SCroute" class="nav-btn"><i class="fas fa-route"></i> Routes</a>
                <a href="/sample3D" class="nav-btn "><i class="fas fa-map-marked-alt"></i> Dispatch Area</a>
            </nav>
            <div class="upload-section"> 
                <a href="/farePrice" class="upload-btn active"><i class="fas fa-ticket-alt"></i> Fare Prices</a>
            </div>
        </aside>

        <main class="main-content">
            <header class="dashboard-header">
                <div class="header-left">
                    <h1>Welcome, {{adminAuth.first_name}}</h1>
                    <p>Vehicles</p>
                </div>
                
                <div class="header-right">
          <div class="admin-info">
            <strong>{{adminAuth.role}}</strong>
        </div>
            </header>

            
               <div class="tab-header">
                <button class="tab-btn active" data-target="vanPanel">
                    <i class="fas fa-shuttle-van"></i> Van
                </button>
                <button class="tab-btn" data-target="busPanel">
                    <i class="fas fa-bus"></i> Bus
                </button>
            </div>

<div id="vanPanel" class="tab-panel"></div>

<div id="busPanel" class="tab-panel hidden"></div>


            </main>
        </div>
  </div>
</body>
</html> 