<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Routes | South Cotabato Transport</title>
    <link rel="icon" type="image/png" href="/stickers/logo-sys.png" />
    <script defer src="/js/SCroute.js"></script>
    <link rel="stylesheet" href="/css/SCroute.css" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</head>
<body>
    <div class="dashboard-container">
       <aside class="sidebar">
            <div class="logo-container">
                <img src="/stickers/tracking.png" alt="Logo" class="logo" onerror="this.src='https://placehold.co/190x80?text=Dispatch+Hub'">
            </div>
            <nav class="nav-menu">
                <a href="/Dashboard" class="nav-btn"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                <a href="/DriverList" class="nav-btn"><i class="fas fa-users"></i> Driver list</a>
                <a href="/DepartureLogs" class="nav-btn "><i class="fas fa-sign-out-alt"></i> Departure logs</a>
                <a href="/vehicles" class="nav-btn"><i class="fas fa-truck"></i> Vehicles</a>
                <a href="/SCroute" class="nav-btn active"><i class="fas fa-route"></i> Routes</a>
                <a href="/sample3D" class="nav-btn "><i class="fas fa-map-marked-alt"></i> Dispatch Area</a>
            </nav>
            <div class="upload-section">
                <a href="/farePrice" class="upload-btn active"><i class="fas fa-ticket-alt"></i> Fare Prices</a>
            </div>
        </aside>

        <main class="main-content">
            <header class="dashboard-header">
    <div class="header-left">
        <h1>Welcome, {{adminAuth.first_name}}</h1>
        <p>South Cotabato · Dynamic route mapping & vehicle queueing</p>
    </div>

    <div class="header-right">
        <div class="admin-info">
            <strong>{{adminAuth.role}}</strong>
        </div>
    </div>
</header>

<!-- ROUTE GRID -->
<section class="routes-grid">

    <!-- LEFT SIDE -->
    <div class="maps-column">

        <!-- TOP MAP -->
        <div class="map-card">
            <div class="card-header">
                <h2><i class="fas fa-map"></i> Koronadal City Integrated Public Transport Terminal - Route (Vise-versa)</h2>

            </div>

            <div id="mapTop" class="map-view"></div>
        </div>

    </div>

    <!-- RIGHT SIDE -->
    <div class="queue-column">

        <div class="queue-panel">

            <div class="queue-header">

                <div class="queue-title">
                    <h2><i class="fas fa-bus"></i> Vehicle Queueing</h2>
                    <p>Real-time dispatch order based on route assignment</p>
                </div>

                <div class="route-selector">
                <select id="terminal_id" name="terminal_id">
                 <option value="">Select Terminal</option>
                </select>
                </div>

            </div>

            <div class="table-wrapper">
        <div class="head-column">
          <div class="col-driver-name">Driver-name</div>
          <div class="col-vehicle">plate-number</div>
          <div class="col-id">travel-count</div>
        </div>


            </div>

        </div>

    </div>

</section>

</body>
</html> 