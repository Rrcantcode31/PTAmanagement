<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard</title>
  <link rel="icon" type="image/png" href="/stickers/logo-sys.png" />
  <link rel="stylesheet" href="/css/dashboard.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script defer src="/js/dashboard.js"></script>\
  <script defer src="/js/dashboard-stats.js"></script>
  <script defer src="/js/admin-profile.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script defer src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  
</head>
<body>  
  <div class="dashboard-container">
    <!-- SIDEBAR -->
    <aside class="sidebar">
            <div class="logo-container">
                <img src="/stickers/tracking.png" alt="Logo" class="logo" onerror="this.src='https://placehold.co/190x80?text=Dispatch+Hub'">
            </div>
            <nav class="nav-menu">
                <a href="/Dashboard" class="nav-btn active"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                <a href="/DriverList" class="nav-btn"><i class="fas fa-users"></i> Driver list</a>
                <a href="/DepartureLogs" class="nav-btn "><i class="fas fa-sign-out-alt"></i> Departure logs</a>
                <a href="/vehicles" class="nav-btn"><i class="fas fa-truck"></i> Vehicles</a>
                <a href="/SCroute" class="nav-btn"><i class="fas fa-route"></i> Routes</a>
                <a href="/sample3D" class="nav-btn "><i class="fas fa-map-marked-alt"></i> Dispatch Area</a>
            </nav>
            <div class="upload-section">
                <a href="/farePrice" class="upload-btn active"><i class="fas fa-ticket-alt"></i> Fare Prices</a>
            </div>
        </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">

      <div class="dashboard-row">

      <div 
          id="admin-profile-trigger" 
          class="admin-profile-avatar"
          role="button"
          tabindex="0"
          aria-label="Open admin profile"
      >
          <img 
              src="{{#if adminAuth.admin_profile}}{{adminAuth.admin_profile}}{{else}}https://ui-avatars.com/api/?name={{adminAuth.first_name}}+{{adminAuth.last_name}}&background=43aca1&color=fff&size=200{{/if}}"
              alt="Admin"
              onerror="this.src='https://ui-avatars.com/api/?name=A&background=999&color=fff'"
          />
      </div>

      <!-- HEADER -->
      <header class="dashboard-header">
        <div class="header-left">
          <h1>Welcome, {{adminAuth.first_name}}</h1>
          <p>Dashboard Overview</p>
        </div>

            <div class="header-right">
        <div class="admin-info">
           <strong>{{adminAuth.role}}</strong>
        </div>
    </div>
            </header>

      </div>

      <section class="stats-section">

        <div class="stat-card">
            <div class="stat-icon stat-icon-zones">
            <i class="fas fa-map-marked-alt"></i>
            </div>
            <div class="stat-content">
            <span class="stat-label">Active Zones</span>
            <span class="stat-value" id="stat-active-zones">—</span>
            <span class="stat-sub" id="stat-active-zones-sub">across — terminals</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon-queue">
            <i class="fas fa-hourglass-half"></i>
            </div>
            <div class="stat-content">
            <span class="stat-label">In Queue</span>
            <span class="stat-value" id="stat-in-queue">—</span>
            <span class="stat-sub">waiting for dispatch</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon-dispatched">
            <i class="fas fa-paper-plane"></i>
            </div>
            <div class="stat-content">
            <span class="stat-label">Dispatched Today</span>
            <span class="stat-value" id="stat-dispatched-today">—</span>
            <span class="stat-sub">trips since midnight</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon-drivers">
            <i class="fas fa-user-check"></i>
            </div>
            <div class="stat-content">
            <span class="stat-label">Drivers Active</span>
            <span class="stat-value" id="stat-active-drivers">—</span>
            <span class="stat-sub">inside polygons now</span>
            </div>
        </div>

        </section>

      <section class="map-section">
    <div class="map-card">

        <!-- Header row: title on the left, legend on the right -->
        <div class="map-header">

            <div class="map-header-left">
                <h2>South Cotabato Terminals-map</h2>
                <p>Visual map of terminal locations across South Cotabato</p>
            </div>

            <div class="map-header-legend">
                <div class="map-legend-item">
                    <span class="map-legend-icon map-legend-pin">
                        <i class="fas fa-map-marker-alt"></i>
                    </span>
                    <div class="map-legend-text">
                        <span class="map-legend-title">Koronadal City Public Terminal</span>
                        <span class="map-legend-sub">Main hub — all routes originate here</span>
                    </div>
                </div>

                <div class="map-legend-item">
                    <span class="map-legend-icon map-legend-dot"></span>
                    <div class="map-legend-text">
                        <span class="map-legend-title">Co-terminals</span>
                        <span class="map-legend-sub">Terminals with routes into the hub</span>
                    </div>
                </div>
            </div>

        </div>

        <div id="map"></div>
    </div>
</section>

    </main>
  </div>

    <div class="floating-actions">  
    <button class="add-btn">Add</button>
    <button class="update-btn">Update</button>
    <button class="delete-btn">Delete</button>
  </div>

  <!-- After map click: coordinates + editable name/address (from reverse geocode) -->
  <div id="terminal-modal" class="terminal-modal hidden" role="dialog" aria-labelledby="terminal-modal-title">
    <h3 id="terminal-modal-title">New terminal</h3>
    <p class="modal-field">
      <label for="modal-name-input">Name</label>
      <input type="text" id="modal-name-input" autocomplete="off" />
    </p>
    <p class="modal-field">
      <label for="modal-address-input">Address</label>
      <textarea id="modal-address-input" rows="3"></textarea>
    </p>
    <p id="modal-geocode-note" class="modal-note"></p>

    <p><strong>Latitude:</strong> <span id="modal-lat"></span></p>
    <p><strong>Longitude:</strong> <span id="modal-lng"></span></p>
    
    <div class="modal-actions">
      <button type="button" id="modal-save">Save</button>
      <button type="button" id="modal-close">Cancel</button>
    </div>
  </div>

  <!-- Validation / Confirmation Modal -->
  <div id="validation-modal" class="validation-modal hidden">
    <div class="validation-modal-overlay"></div>
    <div class="validation-modal-box">
      <div id="validation-icon" class="validation-icon">⚠️</div>
      <h3 id="validation-title">Warning</h3>
      <p id="validation-message"></p>
      <div class="validation-actions">
        <button type="button" id="validation-cancel">Cancel</button>
        <button type="button" id="validation-confirm">OK</button>
      </div>
    </div>
  </div>

  <!-- ==============================
     ADMIN PROFILE — SLIDE DOWN PANEL
     ============================== -->
<div id="admin-drawer-overlay" class="drawer-overlay"></div>
<aside id="admin-drawer" class="admin-drawer" aria-hidden="true">

    <div class="drawer-header">
        <h2><i class="fas fa-user-shield"></i> Admin Profile</h2>
        <button id="admin-drawer-close" class="drawer-close" aria-label="Close">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <div class="drawer-body">

        <div class="drawer-left-col">
            <div class="drawer-avatar-wrap">
                <div class="drawer-avatar">
                    <img id="drawer-avatar-src"
                        src="{{#if adminAuth.admin_profile}}{{adminAuth.admin_profile}}{{else}}https://ui-avatars.com/api/?name={{adminAuth.first_name}}+{{adminAuth.last_name}}&background=43aca1&color=fff&size=200{{/if}}"
                        alt="Admin"
                        onerror="this.src='https://ui-avatars.com/api/?name=A&background=999&color=fff&size=200'" />
                </div>

                <button type="button" class="avatar-upload-btn" id="avatar-upload-btn" title="Change profile picture">
                    <i class="fas fa-camera"></i>
                </button>

                <input type="file" id="avatar-file-input" accept="image/png,image/jpeg,image/webp,image/gif" style="display:none" />
            </div>

            <h3 class="drawer-name">{{adminAuth.first_name}} {{adminAuth.last_name}}</h3>
            <span class="drawer-role-badge">{{adminAuth.role}}</span>

            <div class="drawer-action-stack">
                <button id="toggle-edit-btn" type="button" class="drawer-btn edit-toggle-btn">
                    <i class="fas fa-pen"></i> Edit Profile
                </button>
            </div>
        </div>

        <div class="drawer-right-col">

            <div id="profile-view-mode" class="profile-mode-section">
                <div class="info-grid">
                    <div class="info-card">
                        <span class="info-label"><i class="fas fa-user"></i> First Name</span>
                        <span class="info-value">{{adminAuth.first_name}}</span>
                    </div>
                    <div class="info-card">
                        <span class="info-label"><i class="fas fa-user"></i> Middle Name</span>
                        <span class="info-value">{{#if adminAuth.middle_name}}{{adminAuth.middle_name}}{{else}}—{{/if}}</span>
                    </div>
                    <div class="info-card">
                        <span class="info-label"><i class="fas fa-user"></i> Last Name</span>
                        <span class="info-value">{{adminAuth.last_name}}</span>
                    </div>
                    <div class="info-card">
                        <span class="info-label"><i class="fas fa-envelope"></i> Email Address</span>
                        <span class="info-value">{{adminAuth.email}}</span>
                    </div>
                    <div class="info-card">
                        <span class="info-label"><i class="fas fa-phone"></i> Contact Number</span>
                        <span class="info-value">{{#if adminAuth.contact_number}}{{adminAuth.contact_number}}{{else}}—{{/if}}</span>
                    </div>
                    <div class="info-card">
                        <span class="info-label"><i class="fas fa-shield-alt"></i> Account Role</span>
                        <span class="info-value">{{adminAuth.role}}</span>
                    </div>
                </div>
            </div>

            <div id="profile-edit-mode" class="profile-mode-section hidden">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="profile-first-name"><i class="fas fa-user"></i> First Name</label>
                        <input id="profile-first-name" type="text" value="{{adminAuth.first_name}}" />
                    </div>
                    <div class="form-group">
                        <label for="profile-middle-name"><i class="fas fa-user"></i> Middle Name</label>
                        <input id="profile-middle-name" type="text" value="{{adminAuth.middle_name}}" />
                    </div>
                    <div class="form-group">
                        <label for="profile-last-name"><i class="fas fa-user"></i> Last Name</label>
                        <input id="profile-last-name" type="text" value="{{adminAuth.last_name}}" />
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-envelope"></i> Email (Read-only)</label>
                        <input type="text" value="{{adminAuth.email}}" disabled class="disabled-input" />
                    </div>
                    <div class="form-group">
                        <label for="profile-contact"><i class="fas fa-phone"></i> Contact Number</label>
                        <input id="profile-contact" type="text" value="{{adminAuth.contact_number}}" />
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-shield-alt"></i> Role (Read-only)</label>
                        <input type="text" value="{{adminAuth.role}}" disabled class="disabled-input" />
                    </div>
                </div>
                <!-- No buttons here — they live in the footer -->
            </div>

        </div>

    </div>

    <!-- Footer: Logout on left, Cancel + Save on right -->
    <div class="drawer-footer">

        <a href="/Logout" class="drawer-logout-btn">
            <i class="fas fa-sign-out-alt"></i> Logout
        </a>

        <div class="drawer-footer-actions">
            <button
                type="button"
                id="cancel-profile-btn"
                class="drawer-cancel-btn"
            >
                Cancel
            </button>

            <button
                type="button"
                id="save-profile-btn"
                class="drawer-save-btn"
                disabled
            >
                <i class="fas fa-save"></i> Save Changes
            </button>
        </div>

    </div>

</aside>

</body>

</html>